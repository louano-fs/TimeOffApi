{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=timeclock.db",
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=TimeClock;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "TimeOffApi",
    "Audience": "TimeOffApi.Client",
    "Key": "CHANGE-ME-use-a-long-random-secret-at-least-32-bytes",
    "ExpirationMinutes": 480
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "ManagerAssistant": {
    "Enabled": false,
    "Provider": "OpenAI",
    "Model": "gpt-5-nano",
    "TimeoutSeconds": 20,
    "RequestTimeoutSeconds": 30,
    "MaxOutputTokens": 800,
    "MaxToolRounds": 3,
    "MaxTeamMembers": 200,
    "MaxTeamRangeDays": 92,
    "MaxMessageLength": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
